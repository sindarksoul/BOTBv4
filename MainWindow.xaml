<Window x:Class="BOTB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BOTB Classic Edition"
        Height="600" Width="900"
        Background="#181d23"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Controls -->
            <RowDefinition Height="*"/>
            <!-- Status Output -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0"
                   Text="BestOfTheBest (BOTB) Credential Extractor"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#03d0ff"
                   Margin="0,0,0,16"/>

        <!-- MAIN CONTROLS -->
        <Border Grid.Row="1" Background="#151a21" CornerRadius="8" Padding="10" BorderBrush="#03d0ff" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Target folder/file + Browse -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Folder:" 
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="folderPathBox"
                         Grid.Row="0" Grid.Column="0"
                         Margin="95,0,0,0" Height="24"
                         Background="#232a36" Foreground="White"
                         VerticalContentAlignment="Center"/>
                <Button Content="Browse" Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Width="60" Height="24"
                        Click="BrowseButton_Click" Background="#202533" Foreground="#03d0ff" FontWeight="SemiBold"/>

                <!-- Keywords -->
                <TextBlock Text="Keyword(s): (comma-separated, max 2)" Margin="110,2,10,7" Grid.Column="1" Grid.ColumnSpan="2"/>
                <TextBox x:Name="keywordBox" Height="30" Margin="110,2,10,3" Grid.Column="1" Grid.ColumnSpan="2" />

                <!-- Independent archive extraction, available immediately after launch -->
                <Button Grid.Row="2" Grid.Column="0" Content="Extract Archive (7-Zip)"
                        Margin="0,12,0,0" Height="34" Click="ExtractArchive_Click"
                        Background="#202533" Foreground="#03d0ff" FontWeight="SemiBold"/>

                <Button Grid.Row="2" Grid.Column="2" Content="Open Telegram Desktop"
                        Margin="8,12,0,0" Height="34" Click="OpenTelegram_Click"
                        Background="#202533" Foreground="#03d0ff" FontWeight="SemiBold"/>

                <!-- Radio Buttons (Single/Multi line) + Start -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton x:Name="SingleLineRadio" Content="Single-line Mode" Margin="0,0,24,0"
                                 Foreground="#26fda3" FontWeight="SemiBold" IsChecked="True"/>
                    <RadioButton x:Name="MultiLineRadio" Content="Multi-line Mode"
                                 Foreground="#03d0ff" FontWeight="SemiBold"/>
                </StackPanel>
                <!-- Your main controls here... -->
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="0,8,0,0">
                    <Button Content="Start Extraction"
                        Width="170"
                        Height="36"
                        Margin="0,0,0,8"
                        Click="StartProcessing_Click"
                        Background="#03d0ff"
                        Foreground="White"
                        FontWeight="Bold"/>
                    <Button x:Name="OpenFolderButton"
                        Content="Open Output Folder"
                        Width="170"
                        Height="36"
                        Click="OpenFolderButton_Click"
                        Background="#202533"
                        Foreground="#03d0ff"
                        FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
               <!-- STATUS OUTPUT BOX -->
        <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="#03d0ff" BorderThickness="1" CornerRadius="8" Background="#11141a">
                <TextBox x:Name="statusBox"
                        FontFamily="Consolas"
                        FontSize="14"
                        Background="#11141a"
                        Foreground="#26fda3"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        Padding="8"/>
        </Border>
        <TextBlock Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,12,8" FontSize="11" Background="#11141a">
            <Hyperlink NavigateUri="https://github.com/sindarksoul"
                       RequestNavigate="DeveloperLink_RequestNavigate"
                       Foreground="#03d0ff" TextDecorations="None"><InlineUIContainer BaselineAlignment="Center"><Path Width="13" Height="13" Fill="#03d0ff" Stretch="Uniform" Margin="0,0,4,0" Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.305-5.467-1.333-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.52 11.52 0 0 1 6 0c2.29-1.552 3.297-1.23 3.297-1.23.653 1.652.242 2.873.12 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.807 5.624-5.48 5.921.43.372.823 1.102.823 2.222 0 1.606-.015 2.898-.015 3.293 0 .32.216.694.825.576C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></InlineUIContainer>Developed By Sindarksoul</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
